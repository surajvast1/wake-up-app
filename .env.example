# Copy to .env and fill in. Expo embeds EXPO_PUBLIC_* at bundle time — restart after changes.

# --- Supabase (optional: OTP sign-in + cloud sync) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The app now uses local device data for the dashboard, tasks, and habits.
# No weather, AQI, nearby places, quote, calendar, or reminder keys are needed.
