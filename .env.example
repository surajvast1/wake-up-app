# Copy to .env and fill in. Expo embeds EXPO_PUBLIC_* at bundle time — restart after changes.

# --- Supabase (optional: OTP sign-in + cloud sync) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google / maps / weather ---
EXPO_PUBLIC_GOOGLE_WHEATHER_API_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# --- Air quality ---
EXPO_PUBLIC_AQICN_TOKEN=

# --- AI (optional: daily quote / tasks) ---
# Daily quote: OpenRouter (OpenAI-compatible). Get a key at https://openrouter.ai/keys
EXPO_PUBLIC_OPENROUTER_API_KEY=
# Optional: OpenRouter model id (default: openai/gpt-4o-mini)
# EXPO_PUBLIC_OPENROUTER_QUOTE_MODEL=anthropic/claude-3.5-haiku
# Optional: site URL for OpenRouter rankings (https://openrouter.ai/docs#request-headers)
# EXPO_PUBLIC_OPENROUTER_HTTP_REFERER=https://your-app.example
# Tasks hook may still use OpenAI Responses API:
EXPO_PUBLIC_OPENAI_API_KEY=
